{
  "name": "tagalong",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "gate": "npm run format && npm run lint && npm run types && npm run test",
    "format": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "types": "tsc -p .",
    "test": "vitest run --project static --project unit --project int",
    "coverage": "vitest run --project unit --project int --coverage",
    "start": "node --no-warnings=ExperimentalWarning service/src/main.ts",
    "cli": "node --no-warnings=ExperimentalWarning service/src/cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/client-ssm": "3.1149.0",
    "@aws-sdk/client-transcribe": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
